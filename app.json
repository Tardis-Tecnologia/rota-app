{
  "expo": {
    "name": "Maricá Conecta",
    "slug": "marica-conecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marica-conecta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prefeituramarica.conecta"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0066CC",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.prefeituramarica.conecta",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O aplicativo precisa da sua localização para mostrar pontos de interesse no mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa acessar suas fotos para anexar uma imagem ao relatório.",
          "cameraPermission": "O aplicativo precisa da câmera para você fotografar o problema e anexar ao relatório."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo precisa da câmera para escanear o QR Code do cupom do cliente."
        }
      ],
      "@react-native-google-signin/google-signin", "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
